<?xml version="1.0" encoding="utf-8" ?>
<component name="HomePage2" extends="Scene">
    <children>

        <!-- Background -->
        <Rectangle
            width="1280"
            height="720"
            color="0x5A2D82FF" />

        <!-- Title -->
        <Label
            id="title"
            text="Welcome to Roku Hub!"
            width="1280"
            height="120"
            horizAlign="center"
            vertAlign="top"
            translation="[0,60]" />

        <!-- Buttons Group -->
        <Group
            id="buttonsGroup"
            width="1280"
            height="200"
            translation="[0,260]">

            <!-- Tic-Tac-Toe (Left) -->
            <Button
                id="btnTic"
                width="360"
                height="110"
                translation="[240,0]"
                focusable="true">
                <Label
                    text="Tic-Tac-Toe"
                    horizAlign="center"
                    vertAlign="center" />
            </Button>

            <!-- Checkers (Right) -->
            <Button
                id="btnCheckers"
                width="360"
                height="110"
                translation="[680,0]"
                focusable="true">
                <Label
                    text="Checkers"
                    horizAlign="center"
                    vertAlign="center" />
            </Button>

        </Group>

        <!-- Footer Text -->
        <Label
            id="Stext"
            text="Select a game using the remote"
            width="1280"
            height="60"
            horizAlign="center"
            vertAlign="bottom"
            translation="[0,-30]" />

    </children>

    <script type="text/brightscript"><![CDATA[
        function init()
            m.top.setFocus(true)

            m.title = m.top.findNode("title")
            m.btnTic = m.top.findNode("btnTic")
            m.btnCheckers = m.top.findNode("btnCheckers")
            m.Stext = m.top.findNode("Stext")

            ' Font sizes
            m.title.font.size = 88
            m.Stext.font.size = 28

            ' Set initial focus to left button
            m.btnTic.setFocus(true)
        end function

        function onKeyEvent(key as String, press as Boolean) as Boolean
            if not press then return false

            if key = "OK" then
                if m.btnTic.isFocused() then
                    print "Tic-Tac-Toe selected"
                    return true
                else if m.btnCheckers.isFocused() then
                    print "Checkers selected"
                    return true
                end if
            end if

            return false
        end function
    ]]></script>

</component>
